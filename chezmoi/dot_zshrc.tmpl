# Requestly Desktop App
# rq       → start (kills existing first if running)
# rq stop  → just kill it
# rq status → check if running
rq() {
  local pidfile="/tmp/requestly.pid"

  _rq_is_running() {
    [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null && return 0
    pgrep -f "requestly-desktop-app" >/dev/null 2>&1 && return 0
    pgrep -f "requestly.*vite" >/dev/null 2>&1 && return 0
    return 1
  }

  _rq_kill() {
    # Kill by pidfile
    if [[ -f "$pidfile" ]]; then
      local old_pid
      old_pid=$(cat "$pidfile")
      if kill -0 "$old_pid" 2>/dev/null; then
        pkill -P "$old_pid" 2>/dev/null
        kill "$old_pid" 2>/dev/null
      fi
    fi
    # Kill desktop app and web app processes
    pkill -f "requestly-desktop-app" 2>/dev/null
    pkill -f "requestly.*vite" 2>/dev/null
    sleep 1
    pkill -9 -f "requestly-desktop-app" 2>/dev/null
    pkill -9 -f "requestly.*vite" 2>/dev/null
    rm -f "$pidfile"
  }

  case "${1:-start}" in
    stop)
      if _rq_is_running; then
        echo "Stopping Requestly..."
        _rq_kill
        echo "Stopped."
      else
        echo "Requestly is not running."
      fi
      ;;
    status)
      local found=0
      if pgrep -f "requestly-desktop-app" >/dev/null 2>&1; then
        echo "Desktop app: running"
        found=1
      else
        echo "Desktop app: not running"
      fi
      if pgrep -f "requestly.*vite" >/dev/null 2>&1; then
        echo "Web app:     running ($(lsof -i :3000 -P -t 2>/dev/null | head -1 | xargs -I{} ps -p {} -o command= 2>/dev/null | sed 's|.*/||'))"
        found=1
      else
        echo "Web app:     not running"
      fi
      [[ $found -eq 0 ]] && [[ -f "$pidfile" ]] && rm -f "$pidfile"
      ;;
    start|*)
      if _rq_is_running; then
        echo "Killing existing Requestly..."
        _rq_kill
      fi
      echo "Starting Requestly Desktop App..."
      (cd /Users/skypart/projects/devspace/requestly/requestly-desktop-app && bash run.sh) &
      echo $! > "$pidfile"
      ;;
  esac
}


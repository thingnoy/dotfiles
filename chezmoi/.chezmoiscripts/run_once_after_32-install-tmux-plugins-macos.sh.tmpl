{{- if (eq .chezmoi.os "darwin") -}}
#!/bin/sh

# Install TPM + tmux plugins — ~/.tmux.conf expects ~/.tmux/plugins/tpm
# (resurrect/continuum are then cloned by TPM's own installer)

source /tmp/chezmoi-utils.sh

printf "${green}[32 - macOS] ${reset}"
{{- if (lt 32 (atoi (env "SCRIPTS_START_AT"))) }}
echo "Skip installing tmux plugins"
exit 0
{{ else }}
echo "Install tmux plugins"
{{- end }}

set -eu

if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
  git clone --depth=1 https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi
"$HOME/.tmux/plugins/tpm/bin/install_plugins" || :
{{ end -}}
